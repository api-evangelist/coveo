                        {
                          "name": "List Groups with Privilege Access Level",
                          "id": "1e921f30-28db-4262-8bff-51e5dc2a7f2a",
                          "protocolProfileBehavior": {
                            "disableBodyPruning": true
                          },
                          "request": {
                            "method": "GET",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "*/*"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/rest/organizations/:organizationId/access/groups?privilegeOwner=<string>&privilegeTargetDomain=<string>&accessLevel=EDIT_ALL&accessLevel=NONE",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "rest",
                                "organizations",
                                ":organizationId",
                                "access",
                                "groups"
                              ],
                              "query": [
                                {
                                  "description": "(Required) The `owner` value the groups privileges must match to be included in the response.",
                                  "key": "privilegeOwner",
                                  "value": "<string>"
                                },
                                {
                                  "description": "(Required) The `targetDomain` value the groups privileges must match to be included in the response.",
                                  "key": "privilegeTargetDomain",
                                  "value": "<string>"
                                },
                                {
                                  "description": "(Required) The [access level](https://docs.coveo.com/en/2818/) the groups privileges must match to be included in the response.</br>**Allowed values:**</br>- `EDIT_ALL`: Groups can edit the organization.</br>- `CUSTOM`: Groups have custom access to the organization.</br>- `VIEW_ALL`: Groups can view the organization.</br>- `NONE`: Groups have no access to the organization.",
                                  "key": "accessLevel",
                                  "value": "EDIT_ALL"
                                },
                                {
                                  "description": "(Required) The [access level](https://docs.coveo.com/en/2818/) the groups privileges must match to be included in the response.</br>**Allowed values:**</br>- `EDIT_ALL`: Groups can edit the organization.</br>- `CUSTOM`: Groups have custom access to the organization.</br>- `VIEW_ALL`: Groups can view the organization.</br>- `NONE`: Groups have no access to the organization.",
