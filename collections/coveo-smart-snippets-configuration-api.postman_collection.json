          "name": "Get Preview for Building an SS Model.",
          "request": {
            "name": "Get Preview for Building an SS Model.",
            "description": {
              "content": "Show how many documents matching SS requirements are in the sources.<br /><br /><details><summary>Privilege required</summary>\n```\n{\"owner\":\"COVEO_ML\",\"targetDomain\":\"ALLOW_CONTENT_PREVIEW\",\"type\":\"ENABLE\",\"targetId\":\"*\"}\n```\n</details>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "organizations",
                ":organizationId",
                "machinelearning",
                "configuration",
                "smartsnippets",
                "preview"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "organizationId",
                  "description": "(Required) The unique identifier of the target [organization](https://docs.coveo.com/en/185/).<br />**Example:** `mycoveocloudv2organizationg8tp8wu3`"
