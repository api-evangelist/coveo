                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sources\": [\n    \"CommunityArticles\",\n    \"SalesforceCatalog\"\n  ],\n  \"filterConditions\": [\n    {\n      \"field\": \"author\",\n      \"operator\": \"EQUALS\",\n      \"value\": \"John Smith\"\n    },\n    {\n      \"field\": \"author\",\n      \"operator\": \"EQUALS\",\n      \"value\": \"John Smith\"\n    }\n  ],\n  \"advancedQuery\": \"@source==(\\\"My source\\\") AND @permanentid AND @language=\\\"English\\\"\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
