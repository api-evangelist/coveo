              },
              {
                "name": "interfaceId",
                "value": "123e4567-e89b-12d3-a456-426614174000",
                "type": "path",
                "description": "The unique identifier of the target search interface."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a search page manifest with detailed information from a [Coveo Cloud organization](https://docs.coveo.com/en/185/)."
        },
