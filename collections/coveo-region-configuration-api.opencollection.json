{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coveo Activity Activities Region Configuration API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://platform.cloud.coveo.com/oauth/authorize",
      "accessTokenUrl": "https://platform.cloud.coveo.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Region Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Region Configurations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.cloud.coveo.com/rest/global/regions"
          },
          "docs": "Lists all available region configurations to access Coveo Cloud."
        },
        {
          "info": {
            "name": "Show Region Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.cloud.coveo.com/rest/global/regions/:region",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Shows the configuration of a specific region."
        }
      ]
    }
  ],
  "bundled": true
}