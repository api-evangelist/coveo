          "name": "Show Access",
          "request": {
            "name": "Show Access",
            "description": {
              "content": "Shows whether the authenticated user has the specified access level (i.e., read or write) to the content of the target snapshot.<br/>**Required privilege:** `Snapshot - View`<br /><br /><details><summary>Privilege required</summary>\n```\n{\"owner\":\"PLATFORM\",\"targetDomain\":\"SNAPSHOTS\",\"type\":\"VIEW\",\"targetId\":\"*\"}\n```\n</details>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "organizations",
                ":organizationId",
                "snapshots",
                ":snapshotId",
                "access"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "snapshotAccessType",
                  "value": "<string>",
                  "description": "(Required) The resource access level to verify.<br/>**Allowed values:**<br/> - `READ`<br/> - `WRITE`"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "organizationId",
                  "description": "(Required) The unique identifier of the [organization](https://docs.coveo.com/en/185/).<br/>**Example:** `startingorganizationg8tp8wu3`"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "snapshotId",
                  "description": "(Required) The unique identifier of the target snapshot.<br/>**Example:** `startingorganization-xzgbf5rdaiqtaznvh74zdwcedi`"
