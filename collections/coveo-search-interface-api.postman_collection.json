              "body": "{\n  \"markup\": \"<atomic-search-interface> ... </atomic-search-interface>\",\n  \"results\": {\n    \"placeholder\": \"--results--\",\n    \"attributes\": {\n      \"display\": \"grid\",\n      \"fields-to-include\": \"source,filetype\",\n      \"density\": \"comfortable\"\n    },\n    \"templates\": [\n      {\n        \"markup\": \"<atomic-result-link></atomic-result-link>\",\n        \"attributes\": {\n          \"must-match-source\": \"salesforce\"\n        }\n      },\n      {\n        \"markup\": \"<atomic-result-link></atomic-result-link>\",\n        \"attributes\": {\n          \"must-match-source\": \"salesforce\"\n        }\n      }\n    ]\n  },\n  \"style\": {\n    \"theme\": \":root { --atomic-primary: #B6254F; }\",\n    \"layout\": \"body { margin: 0; }\"\n  },\n  \"config\": {\n    \"name\": \"ExStore\",\n    \"title\": \"My example store search page\",\n    \"facets\": [\n      {\n        \"field\": \"source\",\n        \"label\": \"Source\"\n      },\n      {\n        \"field\": \"objecttype\",\n        \"label\": \"Object Type\"\n      }\n    ],\n    \"sortCriteria\": [\n      {\n        \"by\": \"relevancy\",\n        \"label\": \"Relevance\"\n      },\n      {\n        \"by\": \"date\",\n        \"label\": \"Date\",\n        \"order\": \"DESC\"\n      },\n      {\n        \"by\": \"field\",\n        \"label\": \"Price\",\n        \"field\": \"price\",\n        \"order\": \"ASC\"\n      }\n    ],\n    \"accesses\": {\n      \"users\": [\n        \"alice@example.com\",\n        \"bob@example.com\"\n      ],\n      \"domains\": [\n        \"example.com\",\n        \"sample.com\"\n      ],\n      \"sharingLinkEnabled\": true,\n      \"sharingDomainEnabled\": true\n    },\n    \"content\": {\n      \"pipeline\": \"8652e601-fdc3-4ec9-90f8-510763ec0956\",\n      \"sources\": [\n        \"sourceNameA\",\n        \"sourceNameB\"\n      ]\n    },\n    \"layout\": \"LIST\"\n  }\n}",
