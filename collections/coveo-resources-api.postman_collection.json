          "name": "Get Resources",
          "request": {
            "name": "Get Resources",
            "description": {
              "content": "Gets resources by resource type for a given organization.</br>**Required privilege:**` {resourceType} - View`<br /><br /><details><summary>Privilege required</summary>\n```\n{\"owner\":\"PLATFORM\",\"targetDomain\":\"ORGANIZATION\",\"type\":\"VIEW\",\"targetId\":\"*\"}\n```\n</details>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "organizations",
                ":organizationId",
                "resources",
                ":resourceType"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "The text to filter resources by (applied to the resource id and name properties).<br/>**Example:** `My Web source`"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "The 0-based number of the results page to fetch.<br/>**Default:** `0`"
                },
                {
                  "disabled": false,
                  "key": "perPage",
                  "value": "50",
                  "description": "The number of results to fetch per page.<br/>**Default:** `50`"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "organizationId",
                  "description": "(Required) The unique identifier of the [Coveo organization](https://docs.coveo.com/en/185/).<br/>**Example:** `startingorganizationg8tp8wu3`"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "resourceType",
                  "description": "(Required) The type of the [resource](https://docs.coveo.com/2820).<br/>**Example:** `SOURCE`"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": null
