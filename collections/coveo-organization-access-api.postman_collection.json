          "id": "8efac3e3-c782-4566-bd57-f3778c310f46",
          "name": "List Groups with Privilege Access Level",
          "request": {
            "name": "List Groups with Privilege Access Level",
            "description": {
              "content": "Lists groups with a specific privilege [access level](https://docs.coveo.com/en/2818/) in an [organization](https://docs.coveo.com/en/185/).</br>See [Privilege reference](https://docs.coveo.com/en/1707/).<br /><br /><details><summary>Privilege required</summary>\n```\n{\"owner\":\"PLATFORM\",\"targetDomain\":\"GROUP\",\"type\":\"VIEW\",\"targetId\":\"*\"}\nOR\n{\"owner\":\"{privilegeOwner}\",\"targetDomain\":\"{privilegeTargetDomain}\",\"type\":\"VIEW\",\"targetId\":\"*\"}\n```\n</details>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "organizations",
                ":organizationId",
                "access",
                "groups"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "privilegeOwner",
                  "value": "<string>",
                  "description": "(Required) The `owner` value the groups privileges must match to be included in the response."
                },
                {
                  "disabled": false,
                  "key": "privilegeTargetDomain",
                  "value": "<string>",
                  "description": "(Required) The `targetDomain` value the groups privileges must match to be included in the response."
                },
                {
                  "disabled": false,
                  "key": "accessLevel",
                  "value": "<string>",
                  "description": "(Required) The [access level](https://docs.coveo.com/en/2818/) the groups privileges must match to be included in the response.</br>**Allowed values:**</br>- `EDIT_ALL`: Groups can edit the organization.</br>- `CUSTOM`: Groups have custom access to the organization.</br>- `VIEW_ALL`: Groups can view the organization.</br>- `NONE`: Groups have no access to the organization."
                },
                {
                  "disabled": false,
                  "key": "accessLevel",
                  "value": "<string>",
                  "description": "(Required) The [access level](https://docs.coveo.com/en/2818/) the groups privileges must match to be included in the response.</br>**Allowed values:**</br>- `EDIT_ALL`: Groups can edit the organization.</br>- `CUSTOM`: Groups have custom access to the organization.</br>- `VIEW_ALL`: Groups can view the organization.</br>- `NONE`: Groups have no access to the organization."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "organizationId",
                  "description": "(Required) The unique identifier of the target [organization](https://docs.coveo.com/en/185/).<br />**Example:** `mycoveocloudv2organizationg8tp8wu3`"
                }
              ]
            },
