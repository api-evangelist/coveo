          "id": "bcb0d23b-cd01-443c-9022-c0f4ed09632f",
          "name": "Unlink the Zendesk Installation",
          "request": {
            "name": "Unlink the Zendesk Installation",
            "description": {
              "content": "Remove the link between the Zendesk Installation and the Coveo Organization.  <br/><br/>**Required privilege:** Search Pages - Edit<br/><details><summary>Privilege required</summary>```{ \"owner\": \"SEARCH_API\", \"targetDomain\": \"SEARCH_PAGES\", \"type\": \"EDIT\", \"targetId\": \"*\" }```</details>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pages",
                ":organizationID",
                "zendesk",
                "unlink"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) The Zendesk Installation Id.",
                    "type": "text/plain"
                  },
                  "key": "installationId",
                  "value": ""
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "organizationID",
                  "description": "(Required) The unique identifier of the target Coveo Cloud [organization](https://docs.coveo.com/en/185) (e.g., 'mycoveocloudv2organizationg8tp8wu3')."
                }
              ]
            },
            "method": "DELETE"
          },
          "response": [
            {
              "id": "04ddf6fb-8ae0-46cc-9a9b-a1b21026330a",
