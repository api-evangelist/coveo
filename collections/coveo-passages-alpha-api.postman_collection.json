      "item": [
        {
          "id": "629cc597-0153-4e6a-87ee-0de794fe914b",
          "name": "Allow to Debug Passage(s) Retrieval.",
          "request": {
            "name": "Allow to Debug Passage(s) Retrieval.",
            "description": {
              "content": "API that allows to debug how the passage(s) retrieval was performed for a particular query.\n\n**Note**: The debug endpoint of the Passage Retrieval API is currently in alpha.\n\n<details>\n<summary>Privilege(s) required</summary>\n\n```json\n{\"level\":\"NORMAL\",\"owner\":\"SEARCH_API\",\"targetDomain\":\"EXECUTE_QUERY\",\"type\":\"ENABLE\",\"targetId\":\"*\"}\n```\n</details>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "search",
                "alpha",
                "passages",
                "retrieve",
                "debug"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "organizationId",
                  "value": "<string>",
                  "description": "(Required) The unique identifier of the target Coveo Cloud organization."
                },
                {
                  "disabled": false,
                  "key": "viewAllContent",
                  "value": "<boolean>",
                  "description": "Whether to bypass document permissions. Only effective if the access token grants the **Search - View all content** privilege."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "full"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://platform.cloud.coveo.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://platform.cloud.coveo.com/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"localization\": {\n    \"locale\": \"<string>\",\n    \"timezone\": \"<string>\"\n  },\n  \"filter\": \"<string>\",\n  \"additionalFields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"maxPassages\": 5,\n  \"pipeline\": \"<string>\",\n  \"searchHub\": \"<string>\",\n  \"context\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  },\n  \"analytics\": {\n    \"capture\": \"<boolean>\",\n    \"clientId\": \"<string>\",\n    \"userAgent\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "024476dd-fa17-40dc-b281-0b2590490151",
              "name": "OK",
              "originalRequest": {
                "url": {
                  "path": [
                    "rest",
                    "search",
                    "alpha",
                    "passages",
                    "retrieve",
                    "debug"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "organizationId",
                      "value": "<string>"
                    },
                    {
                      "key": "viewAllContent",
                      "value": "<boolean>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: oauth2",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "<token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"query\": \"What are the benefits of using solar energy?\",\n  \"localization\": {\n    \"locale\": \"en-CA\",\n    \"timezone\": \"America/Montreal\"\n  },\n  \"filter\": \"@source==\\\"acme\\\"\\n\",\n  \"additionalFields\": [\n    \"clickableuri\"\n  ],\n  \"maxPassages\": 5,\n  \"pipeline\": \"CustomerQueryPipeline\",\n  \"searchHub\": \"Main\",\n  \"context\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  },\n  \"analytics\": {\n    \"capture\": \"<boolean>\",\n    \"clientId\": \"<string>\",\n    \"userAgent\": \"<string>\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
