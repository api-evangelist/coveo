{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coveo Activity Activities Relevance Generative Answering Configuration API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://platform.cloud.coveo.com/oauth/authorize",
      "accessTokenUrl": "https://platform.cloud.coveo.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Relevance Generative Answering Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Preview for Building an RGA Model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.cloud.coveo.com/rest/organizations/:organizationId/machinelearning/configuration/rga/preview",
            "params": [
              {
                "name": "organizationId",
                "value": "mycoveocloudv2organizationg8tp8wu3",
                "type": "path",
                "description": "The unique identifier of the target [organization](https://docs.coveo.com/en/185/).<br />**Example:** `mycoveocloudv2organizationg8tp8wu3`"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Show how many documents matching various RGA requirements are in the selection.<br /><br /><details><summary>Privilege required</summary>\n```\n{\"owner\":\"COVEO_ML\",\"targetDomain\":\"ALLOW_CONTENT_PREVIEW\",\"type\":\"ENABLE\",\"targetId\":\"*\"}\n```\n</details>"
        }
      ]
    }
  ],
  "bundled": true
}