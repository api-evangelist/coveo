{
  "item": [
    {
      "id": "767d0c51-8775-4919-999c-1803922deb30",
      "name": "Source Status",
      "description": {
        "content": "Update the status of a Push source",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b20f8e98-5230-4c7c-8255-12b07ef271b0",
          "name": "Set the Status of a Push Source",
          "request": {
            "name": "Set the Status of a Push Source",
            "description": {
              "content": "Modifies the current status of a Push source.  \nThis operation allows you to update the activity logs of a Push source (and consequently the activity indicators in the Coveo Cloud V2 administration console).  \nPushing an *active* source status (i.e., `REBUILD`, `REFRESH`, or `INCREMENTAL`) creates an activity. Pushing the `IDLE` status terminates the ongoing activity and marks it as completed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "organizations",
                ":organizationId",
                "sources",
                ":sourceId",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) The status to set the Push source to.  \nThe possible values are: `INCREMENTAL`, `REFRESH`, `REBUILD`, and `IDLE`.  \n**Example:** `REBUILD` (This can only be one of INCREMENTAL,REFRESH,REBUILD,IDLE)",
                    "type": "text/plain"
                  },
                  "key": "statusType",
                  "value": ""
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "sourceId",
                  "description": "(Required) The unique identifier of the target Push source (see [Creating a Push Source](https://developers.coveo.com/x/34s9Ag)).  \n**Example:** `rp5rxzbdz753uhndklv2ztkfgy-mycoveocloudv2organizationg8tp8wu3`"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "organizationId",
                  "description": "(Required) The unique identifier of the target Coveo Cloud V2 organization.  \n**Example:** `mycoveocloudv2organizationg8tp8wu3`"
                }
              ]
            },
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "full"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://platform.cloud.coveo.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://platform.cloud.coveo.com/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
