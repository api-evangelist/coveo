{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coveo Activity Activities Invites API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://platform.cloud.coveo.com/oauth/authorize",
      "accessTokenUrl": "https://platform.cloud.coveo.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Invites",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Groups Current User Is Invited to",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.cloud.coveo.com/rest/invites"
          },
          "docs": "Lists all groups that the current user is currently invited to."
        }
      ]
    }
  ],
  "bundled": true
}